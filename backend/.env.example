# Local Docker Compose (see root docker-compose.yml)
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# Supabase (production): Project Settings → Database → Connection string (URI)
# Use the pooler URL for serverless/Railway if needed.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

API_KEY=change-me-to-a-long-random-secret
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Set to false in production once you manage migrations
TYPEORM_SYNC=true
